{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://studypilot.local/schemas/feature-list.schema.json",
  "title": "StudyPilot Harness Feature List",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "lastUpdated", "features"],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "schemaVersion": {
      "const": 1
    },
    "lastUpdated": {
      "type": "string",
      "format": "date-time"
    },
    "features": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/feature"
      }
    }
  },
  "$defs": {
    "feature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "phase",
        "name",
        "description",
        "dependencies",
        "status",
        "acceptanceCriteria",
        "branch",
        "evidence",
        "docsToUpdate"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z]+-[0-9]{3}$"
        },
        "phase": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "dependencies": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z]+-[0-9]{3}$"
          }
        },
        "status": {
          "enum": ["blocked", "ready", "in_progress", "done", "verified"]
        },
        "acceptanceCriteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "branch": {
          "type": "string",
          "pattern": "^[a-z]+/[a-z0-9][a-z0-9-]*$"
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "docsToUpdate": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
